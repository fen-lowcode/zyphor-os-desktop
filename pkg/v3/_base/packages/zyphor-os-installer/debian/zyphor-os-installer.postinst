#!/bin/sh
set -e

# Calamares' branding texts, from the release file (the single source of the
# distro's name and version). The images are in
# /usr/share/calamares/branding/zyphor-os/.
generate_branding() {
    . /usr/lib/zyphor-os-release    # DISTRO_ID, DISTRO_NAME, DISTRO_VERSION
    images=/usr/share/calamares/branding/zyphor-os
    mkdir -p /etc/calamares/branding/zyphor-os
    cat > /etc/calamares/branding/zyphor-os/branding.desc.new <<EOT
# Generated by zyphor-os-installer's postinst from /usr/lib/zyphor-os-release.
---
componentName:  zyphor-os
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,580px
windowPlacement: center

strings:
    productName:         "$DISTRO_NAME"
    shortProductName:    "$DISTRO_NAME"
    version:             "$DISTRO_VERSION"
    shortVersion:        "$DISTRO_VERSION"
    versionedName:       "$DISTRO_NAME $DISTRO_VERSION"
    shortVersionedName:  "$DISTRO_NAME $DISTRO_VERSION"
    bootloaderEntryName: "$DISTRO_NAME"

images:
    productLogo:         "$images/logo.png"
    productIcon:         "$images/logo.png"
    productWelcome:      "$images/welcome.png"

slideshow:
    - "$images/slide.png"

style:
    SidebarBackground:        "#0f2027"
    SidebarText:              "#ffffff"
    SidebarTextCurrent:       "#ffffff"
    SidebarBackgroundCurrent: "#2c5364"
EOT
    mv /etc/calamares/branding/zyphor-os/branding.desc.new /etc/calamares/branding/zyphor-os/branding.desc
}

# The live user's full name (live-config's default is "Debian Live user"),
# shown e.g. in the panel's session menu.
generate_live_config() {
    . /usr/lib/zyphor-os-release
    mkdir -p /etc/live/config.conf.d
    printf '# Generated by zyphor-os-installer (live image only).\nLIVE_USER_FULLNAME="%s live user"\n' \
        "$DISTRO_NAME" > /etc/live/config.conf.d/zyphor-os-installer.conf
}

if [ "$1" = "configure" ]; then
    generate_branding
    generate_live_config
fi

#DEBHELPER#
