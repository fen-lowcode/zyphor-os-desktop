// ============================================================
//  Zyphor OS 3 "Bethany" LTS - Plymouth boot splash
//  Only requires: zyphor.png
// ============================================================

// ---------- Screen & background ----------
screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();
center_x = screen_width / 2;
center_y = screen_height / 2;

Window.SetBackgroundTopColor(0.05, 0.05, 0.07);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.04);

// ---------- Logo ----------
logo_image  = Image("zyphor.png");
logo_sprite = Sprite(logo_image);
logo_x = center_x - logo_image.GetWidth() / 2;
logo_y = center_y - logo_image.GetHeight() / 2 - 80;
logo_sprite.SetPosition(logo_x, logo_y, 10);
logo_sprite.SetOpacity(0);

logo_bottom = logo_y + logo_image.GetHeight();

// ---------- Title & release label ----------
title_image  = Image.Text("Zyphor OS", 1, 1, 1, 1, "Sans Bold 22");
title_sprite = Sprite(title_image);
title_sprite.SetPosition(center_x - title_image.GetWidth() / 2, logo_bottom + 20, 10);
title_sprite.SetOpacity(0);

release_image  = Image.Text("3 \"Bethany\" LTS", 0.0, 0.8, 1.0, 1, "Sans 14");
release_sprite = Sprite(release_image);
release_sprite.SetPosition(center_x - release_image.GetWidth() / 2, logo_bottom + 55, 10);
release_sprite.SetOpacity(0);

// ---------- Orbiting dot spinner (text glyphs, no image files) ----------
DOT_COUNT   = 10;
SPIN_RADIUS = 26;
spinner_cy  = logo_bottom + 130;

dot_image = Image.Text("●", 0.0, 0.8, 1.0, 1, "Sans 10");
dot_w = dot_image.GetWidth();
dot_h = dot_image.GetHeight();

dots = [];
for (i = 0; i < DOT_COUNT; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetOpacity(0);
}

// ---------- Progress bar (scaled solid-block glyph) ----------
BAR_WIDTH  = 320;
BAR_HEIGHT = 4;
bar_x = center_x - BAR_WIDTH / 2;
bar_y = spinner_cy + 60;

fun make_bar(w, r, g, b) {
    block = Image.Text("█", r, g, b, 1, "Sans 20");
    return block.Scale(w, BAR_HEIGHT);
}

bar_bg = Sprite(make_bar(BAR_WIDTH, 0.2, 0.2, 0.25));
bar_bg.SetPosition(bar_x, bar_y, 5);

bar_fill = Sprite();
bar_fill.SetPosition(bar_x, bar_y, 6);

progress = 0;
display_progress = 0;
last_fill_w = 0;

fun boot_progress_cb(time, prog) {
    progress = prog;
}
Plymouth.SetBootProgressFunction(boot_progress_cb);

// ---------- Main animation loop (~50 fps) ----------
frame = 0;

fun refresh_callback() {
    frame++;
    t = frame / 50.0;

    // Fade-in
    fade = Math.Min(frame / 75.0, 1);

    // Logo "breathing" pulse
    pulse = 0.85 + 0.15 * Math.Sin(t * 2);
    logo_sprite.SetOpacity(fade * pulse);
    title_sprite.SetOpacity(fade);
    release_sprite.SetOpacity(Math.Max(0, Math.Min((frame - 30) / 75.0, 1)));

    // Orbiting dots with a fading tail
    head = Math.Int(frame / 5) % DOT_COUNT;
    for (i = 0; i < DOT_COUNT; i++) {
        angle = (i / DOT_COUNT) * 2 * Math.Pi - Math.Pi / 2;
        dx = center_x + SPIN_RADIUS * Math.Cos(angle) - dot_w / 2;
        dy = spinner_cy + SPIN_RADIUS * Math.Sin(angle) - dot_h / 2;
        dots[i].SetPosition(dx, dy, 10);

        dist = head - i;
        if (dist < 0) dist += DOT_COUNT;
        trail = 1 - (dist / DOT_COUNT);
        dots[i].SetOpacity(fade * (0.15 + 0.85 * trail * trail));
    }

    // Smooth progress bar easing toward real boot progress
    display_progress += (progress - display_progress) * 0.08;
    fill_w = Math.Int(BAR_WIDTH * display_progress);
    if (fill_w > 0 && fill_w != last_fill_w) {
        bar_fill.SetImage(make_bar(fill_w, 0.0, 0.8, 1.0));
        last_fill_w = fill_w;
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---------- Password prompt (LUKS etc.) ----------
prompt_sprite = Sprite();
bullet_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
    p_img = Image.Text(prompt, 1, 1, 1, 1, "Sans 12");
    prompt_sprite.SetImage(p_img);
    prompt_sprite.SetPosition(center_x - p_img.GetWidth() / 2, bar_y + 40, 20);
    prompt_sprite.SetOpacity(1);

    text = "";
    for (i = 0; i < bullets; i++) text += "●";
    b_img = Image.Text(text, 0.0, 0.8, 1.0, 1, "Sans 14");
    bullet_sprite.SetImage(b_img);
    bullet_sprite.SetPosition(center_x - b_img.GetWidth() / 2, bar_y + 70, 20);
    bullet_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    bullet_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ---------- Status messages ----------
message_sprite = Sprite();

fun display_message_callback(text) {
    m_img = Image.Text(text, 1, 1, 1, 1, "Sans 11");
    message_sprite.SetImage(m_img);
    message_sprite.SetPosition(center_x - m_img.GetWidth() / 2, screen_height - 50, 20);
    message_sprite.SetOpacity(1);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);

fun hide_message_callback(text) {
    message_sprite.SetOpacity(0);
}
Plymouth.SetHideMessageFunction(hide_message_callback);

// ---------- Quit ----------
fun quit_callback() {
    logo_sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);