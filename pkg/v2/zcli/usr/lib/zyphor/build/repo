#!/bin/bash

zyphor_build_repo() {
  echo "[zyphor] Generating repository metadata..."

  if [ ! -d "pool" ]; then
    echo "[error] pool directory not found"
    exit 1
  fi

  read -rp "[zyphor] Enter LTS codename: " codename

  if [ -z "$codename" ]; then
    echo "[error] LTS codename cannot be empty"
    exit 1
  fi

  mkdir -p "dists/$codename/main/binary-amd64"

  dpkg-scanpackages pool /dev/null > "dists/$codename/main/binary-amd64/Packages"

  if [ $? -ne 0 ]; then
    echo "[error] Failed to generate Packages file"
    exit 1
  fi

  gzip -kf "dists/$codename/main/binary-amd64/Packages"

  echo "[zyphor] Repository metadata generated"
  echo "[zyphor] LTS codename: $codename"
  echo "[zyphor] Repository: dists/$codename/main/binary-amd64"
}