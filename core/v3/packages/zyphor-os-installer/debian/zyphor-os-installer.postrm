#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -f /etc/calamares/branding/zyphor-os/branding.desc
    rm -f /etc/live/config.conf.d/zyphor-os-installer.conf
    rmdir /etc/calamares/branding/zyphor-os /etc/calamares/branding 2>/dev/null || true
    dpkg-divert --package zyphor-os-installer --rename \
        --remove /usr/share/applications/calamares.desktop >/dev/null
fi

#DEBHELPER#
